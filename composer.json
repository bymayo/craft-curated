{
  "name": "bymayo/curated",
  "description": "Manually order related elements per source in Craft CMS.",
  "keywords": ["craftcms", "craft-plugin", "fields", "relations", "sort", "ordering", "curated"],
  "type": "craft-plugin",
  "version": "1.0.1",
  "license": "proprietary",
  "support": {
    "email": "jason@bymayo.co.uk",
    "issues": "https://github.com/bymayo/craft-curated/issues?state=open",
    "source": "https://github.com/bymayo/craft-curated",
    "docs": "https://github.com/bymayo/craft-curated",
    "rss": "https://github.com/bymayo/craft-curated/releases.atom"
  },
  "require": {
    "php": ">=8.2",
    "craftcms/cms": "^5.7.0"
  },
  "require-dev": {
    "craftcms/phpstan": "dev-main"
  },
  "autoload": {
    "psr-4": {
      "bymayo\\curated\\": "src/"
    }
  },
  "extra": {
    "handle": "curated",
    "name": "Curated",
    "developer": "Jason Mayo",
    "documentationUrl": "https://github.com/bymayo/craft-curated"
  },
  "config": {
    "sort-packages": true,
    "platform": {
      "php": "8.2"
    },
    "allow-plugins": {
      "yiisoft/yii2-composer": true,
      "craftcms/plugin-installer": true
    }
  }
}
