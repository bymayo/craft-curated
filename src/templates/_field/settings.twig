{% import "_includes/forms" as forms %}

{{ forms.selectField({
    label: "View mode"|t('curated'),
    instructions: "How selected elements should be displayed in the picker."|t('curated'),
    id: 'viewMode',
    name: 'viewMode',
    options: [
        { value: 'list', label: 'List' },
        { value: 'large', label: 'Large thumbnails' },
    ],
    value: field.viewMode,
}) }}

{{ forms.selectField({
    label: "Default Placement"|t('curated'),
    instructions: "Where auto-discovered relations are placed before they're explicitly ordered. Items you've dragged keep their saved position regardless."|t('curated'),
    id: 'initialSort',
    name: 'initialSort',
    options: [
        { value: 'none', label: 'After other elements'|t('curated') },
        { value: 'placeAtTop', label: 'Before other elements'|t('curated') },
        { value: 'titleAsc', label: 'Title (A–Z)'|t('curated') },
        { value: 'titleDesc', label: 'Title (Z–A)'|t('curated') },
        { value: 'dateCreatedDesc', label: 'Date created (newest first)'|t('curated') },
        { value: 'dateCreatedAsc', label: 'Date created (oldest first)'|t('curated') },
        { value: 'dateUpdatedDesc', label: 'Date updated (newest first)'|t('curated') },
        { value: 'random', label: 'Random'|t('curated') },
    ],
    value: field.initialSort,
}) }}

{# Build the dropdown options: [class => label] → [{value, label}] #}
{% set typeOptions = [] %}
{% for class, label in elementTypes %}
    {% set typeOptions = typeOptions|merge([{ value: class, label: label }]) %}
{% endfor %}

{{ forms.selectField({
    label: "Element type"|t('curated'),
    instructions: "Which element type can be curated in this field."|t('curated'),
    id: 'targetElementType',
    name: 'targetElementType',
    options: typeOptions,
    value: field.targetElementType,
    required: true,
}) }}

{# One Craft-native checkboxSelectField per element type. #}
{# Only the active wrapper's inputs submit — see JS below. #}
{% for class, options in sourcesByType %}
    {% set classSlug = class|replace({'\\': '-'}) %}
    {% set isActive = field.targetElementType == class %}

    <div class="curated-sources"
         data-element-type="{{ class }}"
         {% if not isActive %}style="display:none"{% endif %}>
        {% if options is empty %}
            <div class="field">
                <div class="heading">
                    <label>{{ "Sources"|t('curated') }}</label>
                </div>
                <div class="input">
                    <p class="light">{{ "No sources defined for this element type yet."|t('curated') }}</p>
                </div>
            </div>
        {% else %}
            {{ forms.checkboxSelectField({
                label: "Sources"|t('curated'),
                instructions: "Which sources do you want to allow?"|t('curated'),
                id: 'sources-' ~ classSlug,
                name: 'sources',
                options: options,
                values: field.sources,
                showAllOption: true,
            }) }}
        {% endif %}
    </div>
{% endfor %}

{# Type switch: hide inactive wrappers and blank their input `name` so they #}
{# don't submit. We leave `disabled` alone so Craft's CheckboxSelect JS keeps #}
{# managing the All / per-source toggle state inside each wrapper. #}
{% js %}
(function() {
    var typeSelect = document.getElementById('{{ "targetElementType"|namespaceInputId }}');
    if (!typeSelect) return;

    function sync() {
        document.querySelectorAll('.curated-sources').forEach(function(wrapper) {
            var active = wrapper.dataset.elementType === typeSelect.value;
            wrapper.style.display = active ? '' : 'none';
            wrapper.querySelectorAll('input').forEach(function(input) {
                if (!input.dataset.curatedOriginalName && input.name) {
                    input.dataset.curatedOriginalName = input.name;
                }
                input.name = active ? (input.dataset.curatedOriginalName || '') : '';
            });
        });
    }

    typeSelect.addEventListener('change', sync);
    sync();
})();
{% endjs %}
