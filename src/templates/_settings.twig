{% import "_includes/forms" as forms %}

{% css %}
#content-container form > .field:first-child,
#content > form > .field:first-child {
    margin-top: 0;
}
{% endcss %}

{{ forms.textareaField({
    label: "Notice"|t('curated'),
    instructions: "Subtle help text rendered below every Curated field input. Leave blank to hide."|t('curated'),
    id: 'editorNotice',
    name: 'editorNotice',
    value: settings.editorNotice,
    rows: 3,
    disabled: config.editorNotice is defined,
}) }}

{{ forms.lightswitchField({
    label: "Fully remove on delete"|t('curated'),
    instructions: "Also deletes the underlying relation. No undo."|t('curated'),
    warning: "Removing an item edits the canonical relation, not just this field."|t('curated'),
    id: 'removeNativeRelations',
    name: 'removeNativeRelations',
    on: settings.removeNativeRelations,
    disabled: config.removeNativeRelations is defined,
}) }}
