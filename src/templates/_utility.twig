<p>{{ "Syncs and adds any missing related elements to each Curated field. Safe to re-run, already-curated items stay in place."|t('curated') }}</p>

<form method="post" accept-charset="UTF-8">
    {{ csrfInput() }}
    {{ actionInput('curated/sync/run') }}
    {{ redirectInput('utilities/curated-sync') }}

    <button type="submit" class="btn submit">
        {{ "Sync Curated Fields"|t('curated') }}
    </button>
</form>
